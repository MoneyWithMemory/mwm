     for txo in db_data
         .txos
@@ -4318,6 +4327,12 @@ pub(crate) fn swap_fetch_consignment_to_file(
     wallet: &Wallet,
     consignment: &OnchainSwapConsignment,
 ) -> Result<PathBuf, Error> {
+    let target_dir = wallet
+        .wallet_dir()
+        .join("swap-receive")
